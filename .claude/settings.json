{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/hooks/garde_office.py\"",
            "timeout": 10,
            "statusMessage": "Garde-fou écriture Office synchronisée"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/hooks/garde_suppression.py\"",
            "timeout": 10,
            "statusMessage": "Garde-fou suppression/déplacement (Drive synchronisé)"
          }
        ]
      },
      {
        "matcher": "mcp__.*__editJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/hooks/pas_ecraser_jira.py\"",
            "timeout": 30,
            "statusMessage": "Contrôle anti-écrasement (description Jira)"
          }
        ]
      },
      {
        "matcher": "mcp__.*__notion-move-pages",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/hooks/garde_suppression.py\"",
            "timeout": 10,
            "statusMessage": "Garde-fou déplacement de page Notion (notifie)"
          }
        ]
      },
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/hooks/journal_usage.py\"",
            "timeout": 10,
            "statusMessage": "Journal d'usage (skills/agents)"
          }
        ]
      }
    ]
  }
}
